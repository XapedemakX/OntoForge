# Assistant IA — fournisseur : anthropic | openai_compat | ollama | mock
# Mettre "anthropic" et renseigner ANTHROPIC_API_KEY pour activer Claude (sinon : mock)
ONTOFORGE_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ONTOFORGE_LLM_MODEL=claude-sonnet-5-5
# Pour un fournisseur compatible OpenAI (Azure OpenAI, vLLM, LM Studio...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Pour Ollama local
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Port de l interface web (http://localhost:<port>)
ONTOFORGE_PORT=8088
# Adresse sur laquelle le port est publié : 127.0.0.1 = cette machine seulement (défaut, recommandé).
# Pour ouvrir l instance au réseau, activez d abord l authentification (guide, « Ouvrir l instance au réseau »), puis mettez 0.0.0.0.
# ONTOFORGE_BIND=127.0.0.1
# Origines web autorisées à appeler l API depuis un autre site (séparées par des virgules). Vide = aucune (recommandé).
# ONTOFORGE_CORS_ORIGINS=
# Limitation de débit (requêtes par minute) : ONTOFORGE_RATE_GLOBAL_PER_MIN=900, ONTOFORGE_RATE_ASSISTANT_PER_MIN=20, ONTOFORGE_RATE_HEAVY_PER_MIN=120 ; ONTOFORGE_RATE_LIMIT=0 la coupe.
# Validations SHACL simultanées (un processus par validation, jusqu a 2 Go chacun) : ONTOFORGE_SHACL_SLOTS=2.
# Appels sortants : avec ONTOFORGE_AUTH=password (ou ONTOFORGE_PUBLIC=1), les adresses internes (réseau privé, boucle locale) sont refusées.
# Pour autoriser des endpoints internes précis (noms séparés par des virgules, *.exemple.org accepté), par exemple un Fuseki ou un Ollama du réseau :
# ONTOFORGE_EGRESS_ALLOW_INTERNAL=fuseki.interne.exemple.org,ollama.interne.exemple.org

# Clé maître de chiffrement des clés d'API saisies dans Paramètres (n'importe quelle chaîne longue et secrète).
# Générer : python -c "import secrets;print(secrets.token_urlsafe(48))"
# Si absente, une clé est générée dans le volume séparé /keys (docker compose) ou, hors Docker, dans le dossier de données
# (.secret) ; ONTOFORGE_SECRET_FILE=<chemin> change l emplacement. Rotation : voir docs/CONTRACTS.md §4.
# Le fichier .env contient vos secrets : « chmod 600 .env ».
ONTOFORGE_SECRET_KEY=
