# Assistant IA — fournisseur : anthropic | openai_compat | ollama | mock
# Mettre "anthropic" et renseigner ANTHROPIC_API_KEY pour activer Claude (sinon : mock)
ONTOFORGE_LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ONTOFORGE_LLM_MODEL=claude-sonnet-5-5
# Pour un fournisseur compatible OpenAI (Azure OpenAI, vLLM, LM Studio...)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Pour Ollama local
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Port de l interface web (http://localhost:<port>)
ONTOFORGE_PORT=8088

# Clé maître de chiffrement des clés d'API saisies dans Paramètres (n'importe quelle chaîne longue et secrète).
# Générer : python -c "import secrets;print(secrets.token_urlsafe(48))"
# Si absente, une clé est générée dans le volume de données (/data/.secret). Rotation : voir docs/CONTRACTS.md §4.
ONTOFORGE_SECRET_KEY=
